---
import Base from '../layouts/Base.astro';
import { entries } from '../data/entries';
---
<Base title="Timeline"><header class="page-head"><p class="eyebrow">How this little project grew</p><h1>Timeline</h1><p class="lead">The earliest saved game build I can verify is from September 29, 2026. I may have been thinking about it before that, but this is where my surviving notes start.</p></header><div class="timeline">{entries.map(e=><article class:list={{major:e.milestone}}><span class="date">{e.date}{e.milestone && ' / A bigger step'}</span><h3><a href={'/devlog/'+e.slug+'/'}>{e.title} ↗</a></h3><p>{e.summary}</p></article>)}</div></Base>
