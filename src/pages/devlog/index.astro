---
import Base from '../../layouts/Base.astro';
import { newest } from '../../data/entries';
---
<Base title="Dev Log"><header class="page-head"><p class="eyebrow">Notes from me, while I'm making this thing</p><h1>Dev Log</h1><p class="lead">What I tried, what worked, and the occasional moment where the shotgun and I had different plans.</p></header><div class="filter" data-filter><button type="button" aria-pressed="true" data-tag="all">All</button>{[...new Set(newest.flatMap(e=>e.tags))].sort().map(tag=><button type="button" aria-pressed="false" data-tag={tag}>{tag}</button>)}</div><div class="grid" id="entry-grid">{newest.map(e=><a class:list={['card',{milestone:e.milestone}]} href={'/devlog/'+e.slug+'/'} data-tags={e.tags.join('|')}>{e.image && <img src={e.image} alt={e.imageAlt} loading="lazy" />}<div class="card-content"><span class="date">{e.date}{e.milestone && ' / Milestone'}</span><h3>{e.title}</h3><p>{e.summary}</p>{e.tags.map(tag=><span class="tag">{tag}</span>)}</div></a>)}</div><script>document.querySelectorAll('[data-filter] button').forEach(button=>button.addEventListener('click',()=>{const tag=button.getAttribute('data-tag');document.querySelectorAll('[data-filter] button').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll('#entry-grid .card').forEach(card=>{(card as HTMLElement).hidden=tag!=='all' && !(card.getAttribute('data-tags')||'').split('|').includes(tag||'')})}));</script></Base>
